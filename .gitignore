# === Default: ignore everything at root (keep process/governance files local) ===
/*

# === Public deliverables (docs, schemas, vectors, and reference implementations) ===
!/docs/
!/schema/
!/schemas/
!/vectors/
!/reference-impls/
!/src/
!/package.json
!/pnpm-lock.yaml
!/tsconfig.json
!/vitest.config.ts
!/README.md
!/LICENSE
!/LICENSE-DOCS
!/SECURITY.md
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/.gitignore

# === Exclude build/cache/OS noise inside allowed directories ===
.DS_Store
*.swp
*.swo
*~
Thumbs.db
node_modules/
dist/
coverage/
*.tsbuildinfo
reference-impls/rust/target/
**/target/
